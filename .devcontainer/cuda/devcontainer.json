{
  "name": "Deadline Aware GPU Inference",

  "build": {
    "dockerfile": "../../containers/cuda/Dockerfile",
    "context": "../../containers/cuda"
  },

  "remoteUser": "root",
  "updateRemoteUserUID": false,

  "hostRequirements": {
    "gpu": true
  },

  "runArgs": [
    "--gpus=${localEnv:DEVCONTAINER_GPUS:all}",
    "--umask=0022"
  ],

  "containerEnv": {
    "CUDA_HOME": "/usr/local/cuda",
    "PYTHONUNBUFFERED": "1",
    "PIP_DISABLE_PIP_VERSION_CHECK": "1",

    "PIP_CACHE_DIR": "/root/.cache/pip",
    "TRITON_CACHE_DIR": "/root/.cache/triton",
    "TORCH_EXTENSIONS_DIR": "/root/.cache/torch_extensions"
  },

  "mounts": [
    "source=${localWorkspaceFolderBasename}-cuda-cache,target=/root/.cache,type=volume"
  ],

  "postCreateCommand": "bash scripts/setup_python_envs.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "NVIDIA.nsight-vscode-edition",
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],

      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python",

        "python.testing.pytestEnabled": true,
      
        "C_Cpp.default.compilerPath": "/usr/bin/g++"
      }
    }
  }
}
